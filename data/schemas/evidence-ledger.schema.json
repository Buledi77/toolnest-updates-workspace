{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toolnestai.tech/schemas/evidence-ledger-v1.json",
  "title": "ToolNest evidence ledger",
  "description": "Time-stamped evidence for factual claims. It supports multiple claims per source, multiple sources per tool, regional pricing context, disputes and replacement evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "claims",
    "disputes",
    "replacements",
    "audit_trail"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence-ledger-v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "disputes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dispute"
      }
    },
    "replacements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacement"
      }
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audit_event"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "source_type",
        "publisher",
        "official",
        "accessed_at",
        "verified_at",
        "status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_pricing",
            "official_product",
            "official_documentation",
            "official_help",
            "official_legal",
            "secondary_review",
            "user_report",
            "internal_test"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "official": {
          "type": "boolean"
        },
        "accessed_at": {
          "$ref": "#/$defs/date"
        },
        "verified_at": {
          "$ref": "#/$defs/date"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "billing_term": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "unavailable",
            "needs_review"
          ]
        },
        "source_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "status"
            ],
            "properties": {
              "observed_at": {
                "$ref": "#/$defs/date"
              },
              "status": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "tool_id",
        "field_path",
        "claim_type",
        "value",
        "source_ids",
        "accessed_at",
        "verified_at",
        "status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "capability",
            "limitation",
            "pricing",
            "plan_limit",
            "free_plan",
            "trial",
            "availability",
            "integration",
            "status",
            "url",
            "feature",
            "billing"
          ]
        },
        "value": {},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "billing_term": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_at": {
          "$ref": "#/$defs/date"
        },
        "verified_at": {
          "$ref": "#/$defs/date"
        },
        "stale_after": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "verified_official",
            "verified_official_dynamic",
            "editorial_assessment",
            "research_required",
            "official_source_unavailable",
            "official_source_conflict",
            "needs_review",
            "stale",
            "disputed"
          ]
        },
        "verification_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Explicit field-level verification status when different from claim status. Allows granular tracking: a claim may be 'verified' overall while a specific field within it is 'research_required'.",
          "enum": [
            "verified_official",
            "verified_official_dynamic",
            "editorial_assessment",
            "research_required",
            "official_source_unavailable",
            "official_source_conflict",
            "do_not_publish"
          ]
        },
        "disputed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "replacement_claim_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispute_id",
        "claim_id",
        "status"
      ],
      "properties": {
        "dispute_id": {
          "type": "string"
        },
        "claim_id": {
          "type": "string"
        },
        "raised_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "raised_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "rejected"
          ]
        },
        "resolution_claim_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement_id",
        "old_claim_id",
        "new_claim_id",
        "reason"
      ],
      "properties": {
        "replacement_id": {
          "type": "string"
        },
        "old_claim_id": {
          "type": "string"
        },
        "new_claim_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "replaced_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "audit_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "occurred_at"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "created",
            "verified",
            "rechecked",
            "disputed",
            "resolved",
            "replaced",
            "corrected"
          ]
        },
        "occurred_at": {
          "$ref": "#/$defs/date"
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
